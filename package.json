{
  "name": "apispec-mcp",
  "version": "0.1.0",
  "description": "MCP server for exploring OpenAPI/Swagger specifications without loading the full JSON into the agent context",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "apispec-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch"
  },
  "keywords": [
    "mcp",
    "openapi",
    "swagger",
    "model-context-protocol",
    "ai",
    "cursor",
    "claude"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "openapi-types": "^12.1.3",
    "typescript": "^6.0.2"
  }
}
